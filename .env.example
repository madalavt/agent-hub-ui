# ===================================================
# Agent Hub Web UI & Gateway Configuration (.env)
# ===================================================

# Port configuration
PORT=3000

# Backend Microservice URLs
DECISION_TREE_API_URL=http://localhost:8001
EXTRACTION_API_URL=http://localhost:8002
WORK_ITEMS_API_URL=http://localhost:8003
ANNOTATIONS_API_URL=http://localhost:8004

# Backend Service API Keys (optional for local dev if backend has API_KEY unset)
EXTRACTION_API_KEY=test-api-key
WORK_ITEMS_API_KEY=test-api-key
ANNOTATIONS_API_KEY=test-api-key

# Node environment
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
